# Base URL of the Ollama server.
SR_OLLAMA_BASE_URL=

# Name and tag of the model installed in Ollama.
SR_OLLAMA_MODEL=

# Context window requested for each chat call, in tokens:
SR_OLLAMA_CONTEXT_TOKENS=

# Timeout for blocking socket operations, in seconds.
SR_OLLAMA_TIMEOUT_SECONDS=

# OpenAI project API key. Set the secret in your local .env file.
OPENAI_API_KEY=

# Model identifier used for cloud inference.
SR_OPENAI_MODEL=

# SDK request timeout, in seconds.
SR_OPENAI_TIMEOUT_SECONDS=